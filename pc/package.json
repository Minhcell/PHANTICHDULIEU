{
  "name": "phantichcuocgoi",
  "productName": "PhanTichCuocGoi",
  "version": "1.0.0",
  "description": "Phân tích Cuộc gọi / SMS (offline, mạng LAN)",
  "main": "main.js",
  "author": "Hi",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "vn.phantichcg.pc",
    "productName": "PhanTichCuocGoi",
    "files": ["main.js", "preload.js", "web/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "portable": { "artifactName": "PhanTichCuocGoi.exe", "unpackDirName": "PhanTichCuocGoi" }
  }
}
